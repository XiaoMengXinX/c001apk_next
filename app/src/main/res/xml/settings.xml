<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        2026-10-05 修正：一级菜单只保留「入口」，点进去才是具体开关。
        嵌套 PreferenceScreen 由 SettingsPreferenceFragment.onNavigateToScreen 交给
        独立 Activity（SettingsDetailActivity）打开，与「关于」页一样走系统的跨 Activity
        预测性返回，右滑时可跟手预览（Fragment 返回栈 + res/anim 是拿不到预览的）。
        顺序：外观 / 推荐流相关 / 隐私 / 高级 / 其他 / 关于
        「关于」已提到一级：点击直接打开 AboutActivity（去掉了
        其他 → 关于 → 关于本应用 中间那两层无用目录）。
    -->

    <PreferenceScreen
        android:icon="@drawable/outline_palette_24"
        android:key="appearance"
        android:title="@string/settings_appearance">

        <!--
            2026-10-06：外观屏条目变多之后按用途分组（主题 / 显示 / 布局 / 转场动画），
            转场那三项再收进一层子菜单，免得一级外观页被实验项撑满。
        -->
        <PreferenceCategory android:title="@string/settings_theme">

            <rikka.material.preference.MaterialSwitchPreference
                android:defaultValue="true"
                android:disableDependentsState="true"
                android:icon="@drawable/outline_palette_24"
                android:key="followSystemAccent"
                android:title="@string/settings_system_theme_color" />
            <rikka.preference.SimpleMenuPreference
                android:defaultValue="DEFAULT"
                android:dependency="followSystemAccent"
                android:entries="@array/color_texts"
                android:entryValues="@array/color_values"
                android:icon="@drawable/outline_format_color_fill_24"
                android:key="themeColor"
                android:summary="%s"
                android:title="@string/settings_theme_color" />
            <rikka.preference.SimpleMenuPreference
                android:defaultValue="-1"
                android:entries="@array/theme_texts"
                android:entryValues="@array/theme_values"
                android:icon="@drawable/outline_dark_mode_24"
                android:key="darkTheme"
                android:summary="%s"
                android:title="@string/dark_theme" />
            <rikka.material.preference.MaterialSwitchPreference
                android:icon="@drawable/outline_invert_colors_24"
                android:key="blackDarkTheme"
                android:summary="@string/settings_pure_black_dark_theme_summary"
                android:title="@string/settings_pure_black_dark_theme" />

        </PreferenceCategory>

        <PreferenceCategory android:title="@string/settings_category_display">

            <Preference
                android:icon="@drawable/ic_text_fields"
                android:key="fontScale"
                android:title="@string/font_scale" />
            <rikka.material.preference.MaterialSwitchPreference
                android:defaultValue="true"
                android:icon="@drawable/ic_emoji"
                android:key="showEmoji"
                android:title="@string/show_emoji" />
            <!-- 2026-10-06：从「推荐流相关」挪过来——它只管深色模式下图片的显示，是外观项 -->
            <rikka.material.preference.MaterialSwitchPreference
                android:defaultValue="true"
                android:icon="@drawable/ic_filter"
                android:key="isColorFilter"
                android:title="@string/color_filter_in_dark_mode" />

        </PreferenceCategory>

        <PreferenceCategory android:title="@string/settings_category_layout">

            <!-- 2026-10-05：首页工具栏那个位置让给了消息入口，编辑 Tab 挪到这儿 -->
            <Preference
                android:icon="@drawable/ic_menu"
                android:key="editTab"
                android:summary="@string/edit_tab_summary"
                android:title="@string/edit_tab" />

        </PreferenceCategory>

        <PreferenceCategory android:title="@string/settings_animation">

            <!--
                水平转场动画实验项（临时脚手架）：
                三档组合由 tools/gen_transition_anim.py 预先烘成 res/anim/exp_*.xml，
                运行时按这里的选择查表。手感定下来后，把赢家固化回 right_in / left_out
                等正式资源，并删掉这三项 + TransitionAnim.kt + 那批 exp_* 资源。
                改完直接返回即可看到「退出」动画，再进任意二级页看到「进入」动画。
            -->
            <PreferenceScreen
                android:icon="@drawable/outline_system_update_24"
                android:key="animation"
                android:summary="@string/settings_animation_summary"
                android:title="@string/settings_animation">

                <rikka.preference.SimpleMenuPreference
                    android:defaultValue="emph"
                    android:entries="@array/anim_curve_texts"
                    android:entryValues="@array/anim_curve_values"
                    android:icon="@drawable/outline_system_update_24"
                    android:key="animCurve"
                    android:summary="%s"
                    android:title="@string/settings_transition_curve" />
                <rikka.preference.SimpleMenuPreference
                    android:defaultValue="slide"
                    android:entries="@array/anim_type_texts"
                    android:entryValues="@array/anim_type_values"
                    android:icon="@drawable/outline_widgets_24"
                    android:key="animType"
                    android:summary="%s"
                    android:title="@string/settings_transition_type" />
                <rikka.preference.SimpleMenuPreference
                    android:defaultValue="300"
                    android:entries="@array/anim_speed_texts"
                    android:entryValues="@array/anim_speed_values"
                    android:icon="@drawable/outline_system_update_24"
                    android:key="animDuration"
                    android:summary="%s"
                    android:title="@string/settings_transition_speed" />

            </PreferenceScreen>

        </PreferenceCategory>

    </PreferenceScreen>

    <PreferenceScreen
        android:icon="@drawable/ic_feed"
        android:key="recommendation"
        android:title="@string/settings_recommendation">

        <Preference
            android:icon="@drawable/ic_block"
            android:key="topicBlackList"
            android:title="@string/topic_black_list" />
        <Preference
            android:icon="@drawable/ic_text_fields"
            android:key="spamWord"
            android:title="@string/spam_shield_word" />
        <Preference
            android:icon="@drawable/ic_block"
            android:key="spamUser"
            android:title="@string/spam_shield_user" />
        <Preference
            android:icon="@drawable/ic_block"
            android:key="spamNode"
            android:title="@string/spam_shield_node" />
        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="false"
            android:icon="@drawable/ic_explorer"
            android:key="isOpenLinkOutside"
            android:title="@string/open_link_outside" />
        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="true"
            android:icon="@drawable/ic_feed"
            android:key="isIconMiniCard"
            android:title="@string/show_icon_mini_card" />
        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="true"
            android:icon="@drawable/ic_history"
            android:key="isRecordHistory"
            android:title="@string/record_history" />

    </PreferenceScreen>

    <PreferenceScreen
        android:icon="@drawable/ic_block"
        android:key="privacy"
        android:title="@string/settings_privacy">

        <Preference
            android:icon="@drawable/ic_block"
            android:key="userBlackList"
            android:title="@string/user_black_list" />

    </PreferenceScreen>

    <PreferenceScreen
        android:icon="@drawable/ic_dev_mode"
        android:key="advanced"
        android:title="@string/settings_advanced">

        <!-- 默认开：不信任系统 CA，只用证书链固定公钥校验（关闭则回落到系统校验） -->
        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="true"
            android:icon="@drawable/outline_verified_user_24"
            android:key="verifySsl"
            android:summary="@string/settings_verify_ssl_summary"
            android:title="@string/settings_verify_ssl" />
        <!-- 网络传输调试模式（彻底关闭 SSL 校验）：与上面的严格校验互斥，
             严格校验开着时本项被禁用；开启需要二次确认 + 5 秒等待 -->
        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="false"
            android:icon="@drawable/ic_bug"
            android:key="sslDebug"
            android:summary="@string/settings_ssl_debug_summary"
            android:title="@string/settings_ssl_debug" />
        <!-- 数字联盟 ID 已不再参与 API 请求（改用 iOS CDID，见 IosDeviceUtils / CdidClient）。
             暂时隐藏入口；底层 PrefManager.SZLMID 仍被 WebView 的 DID cookie 与扫码登录的
             duid 参数引用，确认这两处也不需要后再删除相关代码。 -->
        <!--
        <Preference
            android:icon="@drawable/ic_phone"
            android:key="szlmId"
            android:summary="@string/szlmId_summary"
            android:title="@string/szlmId" />
        -->
        <Preference
            android:icon="@drawable/ic_dev_mode"
            android:key="params"
            android:title="@string/params" />
        <Preference
            android:icon="@drawable/ic_image"
            android:key="imageQuality"
            android:title="@string/image_quality" />

        <!-- HTTP 请求日志（默认关 ✓ 打开后全局记录，可导出/清空 ✓） -->
        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="false"
            android:icon="@drawable/ic_bug"
            android:key="recordHttpLog"
            android:summary="@string/settings_http_log_summary"
            android:title="@string/settings_http_log" />
        <Preference
            android:icon="@drawable/ic_clean"
            android:key="httpLogStats"
            android:title="@string/settings_http_log_stats" />
        <Preference
            android:icon="@drawable/ic_more"
            android:key="httpLogExport"
            android:title="@string/settings_http_log_export" />
        <Preference
            android:icon="@drawable/ic_clean"
            android:key="httpLogClear"
            android:title="@string/settings_http_log_clear" />

    </PreferenceScreen>

    <PreferenceScreen
        android:icon="@drawable/ic_more"
        android:key="other"
        android:title="@string/settings_other">

        <Preference
            android:icon="@drawable/ic_clean"
            android:key="clearCache"
            android:title="@string/clear_cache" />

    </PreferenceScreen>

    <!-- 一级「关于」：点击直接进关于页（更新开关 / 立即检查 / 组织按钮都在里面） -->
    <Preference
        android:icon="@drawable/ic_logo"
        android:key="about"
        android:title="@string/about" />

</PreferenceScreen>
