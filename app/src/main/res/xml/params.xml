<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 酷安 API 当前使用 iOS 实现：设备身份 = 已登记的设备 ID + 一组 iPhone 机型参数 -->
    <Preference
        android:key="iosDeviceId"
        android:title="IOS_DEVICE_ID" />
    <Preference
        android:key="iosModel"
        android:title="IOS_MODEL" />
    <Preference
        android:key="iosHardwareId"
        android:title="IOS_HARDWARE_ID" />
    <Preference
        android:key="iosSalesModel"
        android:title="IOS_SALES_MODEL" />
    <Preference
        android:key="iosSystemVersion"
        android:title="IOS_SYSTEM_VERSION" />

    <Preference
        android:key="xAppDevice"
        android:title="@string/xAppDevice" />
    <Preference
        android:key="xAppToken"
        android:title="@string/xAppToken" />
    <Preference
        android:key="regenerate"
        android:title="@string/regenerate" />
    <Preference
        android:key="regenerateDeviceId"
        android:title="重新生成设备 ID" />

</PreferenceScreen>
