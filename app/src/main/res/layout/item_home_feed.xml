<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <import type="com.example.c001apk.util.DateUtils" />

        <variable
            name="data"
            type="com.example.c001apk.logic.model.HomeFeedResponse.Data" />

        <variable
            name="likeData"
            type="com.example.c001apk.logic.model.Like" />

        <variable
            name="listener"
            type="com.example.c001apk.adapter.ItemListener" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{(view) -> listener.onViewFeed(view, data.id, data.userInfo.uid, data.userInfo.username, data.userInfo.userAvatar, data.deviceTitle, data.message, String.valueOf(data.dateline), null, null, data)}"
        app:cardBackgroundColor="@color/home_card_background_color"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/cover"
                android:foreground="@drawable/selector_bg_avatar"
                android:onClick="@{(view) -> listener.onViewUser(view, data.userInfo.uid)}"
                app:layout_constraintBottom_toBottomOf="@id/device"
                app:layout_constraintDimensionRatio="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:setImage="@{data.userInfo.userAvatar}"
                app:shapeAppearance="@style/circleImageStyle" />

            <!-- 认证角标：压在头像右下角，没认证时 GONE -->
            <ImageView
                android:id="@+id/verifyBadge"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:background="@drawable/bg_verify_badge"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/ic_verify_check"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/avatar"
                app:layout_constraintEnd_toEndOf="@id/avatar"
                app:verifyIcon="@{data.userInfo.verifyIcon}"
                app:verifyStatus="@{data.userInfo.verifyStatus}"
                app:verifyUid="@{data.userInfo.uid}" />

            <ImageView
                android:id="@+id/expand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?actionBarItemBackground"
                android:src="@drawable/ic_expand_more"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/uname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:ellipsize="end"
                android:lines="1"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@{data.userInfo.username}"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/expand"
                app:layout_constraintStart_toEndOf="@id/avatar"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/from"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                android:visibility="@{data.infoHtml == null || data.infoHtml.isEmpty ? View.GONE : View.VISIBLE}"
                app:customText="@{data.infoHtml}"
                app:isHtml="@{true}"
                app:layout_constraintStart_toEndOf="@id/avatar"
                app:layout_constraintTop_toBottomOf="@id/uname" />

            <TextView
                android:id="@+id/device"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                android:visibility="@{data.deviceTitle == null || data.deviceTitle.isEmpty ? View.INVISIBLE : View.VISIBLE}"
                app:customText="@{data.deviceTitle}"
                app:icon="@{@drawable/ic_device}"
                app:layout_constraintEnd_toStartOf="@id/privateBadge"
                app:layout_constraintStart_toEndOf="@id/from"
                app:layout_constraintTop_toBottomOf="@id/uname" />

            <!-- 个人主页置顶标记：只有「自己主页的 feedList」会下发 isStickTop -->
            <TextView
                android:id="@+id/topBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_private_badge"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:text="@string/stick_top"
                android:textColor="@android:color/darker_gray"
                android:textSize="11sp"
                android:visibility="@{data.isStickTop != null &amp;&amp; data.isStickTop == 1 ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="@id/device"
                app:layout_constraintEnd_toStartOf="@id/privateBadge"
                app:layout_constraintTop_toTopOf="@id/device" />

            <TextView
                android:id="@+id/privateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_private_badge"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:text="@string/publish_status_private"
                android:textColor="@android:color/darker_gray"
                android:textSize="11sp"
                android:visibility="@{data.publishStatus != null &amp;&amp; data.publishStatus == 1 ? View.VISIBLE : View.GONE}"
                app:layout_constraintBottom_toBottomOf="@id/device"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/device" />

            <TextView
                android:id="@+id/messageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@{data.messageTitle}"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="@{data.messageTitle == null || data.messageTitle.isEmpty ? View.GONE : View.VISIBLE}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/avatar" />

            <com.example.c001apk.view.LinkTextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="5"
                android:text="@{data.message}"
                android:textSize="16sp"
                android:visibility="@{data.message == null || data.message.isEmpty ? View.GONE : View.VISIBLE}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/messageTitle" />

            <!--
                正文被 5 行截断时才露出的「查看更多」，点了进详情页看全文。
                显隐由 AppAdapter.FeedViewHolder 按 message 的排版结果决定；默认 GONE，
                不占位，没被截断的条目不会平白多出一截空档。
            -->
            <TextView
                android:id="@+id/messageMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="查看更多"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/message" />

            <TextView
                android:id="@+id/pubDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@{DateUtils.fromToday(data.dateline)}"
                android:textColor="@android:color/darker_gray"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/forwarded" />

            <TextView
                android:id="@+id/like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/actionBarItemBackground"
                android:onClick="@{() -> listener.onLikeClick(data.entityType, data.id, likeData.isLike())}"
                android:text="@{likeData.likeNum}"
                android:textColor="@android:color/darker_gray"
                app:layout_constraintBaseline_toBaselineOf="@id/pubDate"
                app:layout_constraintEnd_toEndOf="parent"
                app:setLike="@{likeData.isLike}" />

            <TextView
                android:id="@+id/reply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="?attr/actionBarItemBackground"
                android:onClick="@{(view) -> listener.onViewFeed(view, data.id, data.userInfo.uid, data.userInfo.username, data.userInfo.userAvatar, data.deviceTitle, data.message, String.valueOf(data.dateline), null, true, data)}"
                android:textColor="@android:color/darker_gray"
                app:customText="@{data.replynum}"
                app:icon="@{@drawable/ic_message}"
                app:layout_constraintBaseline_toBaselineOf="@id/pubDate"
                app:layout_constraintEnd_toStartOf="@id/like" />

            <!-- 视频槽：视频动态的 pic/picArr 实测是空的，媒体区只能由它出图（见 FeedVideo 里的口径）。
                 与九图槽在数据上互斥，两个槽位落同一位置，谁显示由可见性决定。 -->
            <com.example.c001apk.view.FeedVideoView
                android:id="@+id/videoPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/messageMore" />

            <com.example.c001apk.view.ninegridimageview.NineGridImageView
                android:id="@+id/multiImage"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                app:feedType="@{data.feedType}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/messageMore"
                app:pic="@{data.pic}"
                app:picArr="@{data.picArr}" />

            <!-- 媒体区下沿：视频槽 / 九图槽共用一个位置，谁可见就由谁决定下面的内容从哪开始。
                 用 Barrier 而不是直接把热评挂到九图槽上，是为了不依赖「GONE 视图的边距算不算」这种细则。 -->
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/mediaBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="videoPart,multiImage" />

            <!-- 附加信息槽（点评评分 / 二手 / 商品清单）：实测这三类基本互斥，共用一个槽位；
                 跳转由 ViewHolder 通过 onOpen 交给 ItemListener.onOpenLink。 -->
            <com.example.c001apk.view.FeedExtraView
                android:id="@+id/extraPart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/mediaBarrier" />

            <TextView
                android:id="@+id/hotReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/round_corners_12_win"
                android:clickable="true"
                android:focusable="true"
                android:foreground="@drawable/selector_bg_12_trans"
                android:lineSpacingMultiplier="1.2"
                android:onClick="@{(view) -> listener.onViewFeed(view, data.id, data.userInfo.uid, data.userInfo.username, data.userInfo.userAvatar, data.deviceTitle, data.message, String.valueOf(data.dateline), null, true, data)}"
                android:padding="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/extraPart"
                app:setHotReply="@{data.replyRows[0]}" />

            <LinearLayout
                android:id="@+id/forwarded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/round_corners_12_win"
                android:foreground="@drawable/selector_bg_12_trans"
                android:onClick="@{(view) -> listener.onViewFeed(view, data.forwardSourceFeed.id, ``, ``, ``, ``, ``, ``, null, null, null)}"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="@{data.forwardSourceFeed == null ? View.GONE : View.VISIBLE}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/hotReply">

                <com.example.c001apk.view.LinkTextView
                    android:id="@+id/forwardedMess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:lineSpacingMultiplier="1.2"
                    android:text='@{"&lt;a class=\"feed-link-uname\" href=\"/u/" + data.forwardSourceFeed.uid + "\">@" + data.forwardSourceFeed.username + "&lt;/a>: " + data.forwardSourceFeed.message}'
                    android:textSize="15sp"
                    android:visibility="@{data.forwardSourceFeed.message == null || data.forwardSourceFeed.message.isEmpty ? View.GONE : View.VISIBLE}" />

                <com.example.c001apk.view.ninegridimageview.NineGridImageView
                    android:id="@+id/forwardedPic"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="10dp"
                    app:feedType="@{data.forwardSourceFeed.feedType}"
                    app:pic="@{data.pic}"
                    app:picArr="@{data.forwardSourceFeed.picArr}" />

            </LinearLayout>

            <com.example.c001apk.view.CustomHorizontalScrollView
                android:id="@+id/dyhLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                android:visibility="@{data.targetRow.id == null &amp;&amp; (data.relationRows.size() == 0 || data.relationRows==null) ? View.GONE : View.VISIBLE}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/pubDate">

                <LinearLayout
                    android:id="@+id/linearLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:isFeedContent="@{false}"
                    app:relationRows="@{data.relationRows}"
                    app:targetRow="@{data.targetRow}" />

            </com.example.c001apk.view.CustomHorizontalScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>
