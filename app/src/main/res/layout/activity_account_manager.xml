<?xml version="1.0" encoding="utf-8"?>
<!--
  账号管理页。

  入口：「我的」页工具栏 → 右上角图标（原「退出登录」，改 ic_mine_selector 后跳这里）

  ★ 页面结构（用户指定 2026-10-18 更正）：
    · 上方 **8 宫格（4×2）**
      - 第 1 格 =「扫码登录」（唯一有功能的）
      - 其余 7 格 =「敬请期待」（enabled=false，点不动）
    · 最底部：红色长条形「退出登录」

  ⚠️ 之前我做成了 16 宫格，还编了「设备管理 / 登录记录 / 第三方绑定 /
     安全中心 / 登录密码 / 手机号 / 邮箱」七个名字填进去 ✗
     —— 那些**功能根本不存在**，放上去会让用户以为能用 ✗ 已全部撤掉 ✓

  ★ 只使用已核实的资源：
      string/:  accountManagerTitle scanLogin comingSoon logout
      drawable/: ic_qr_scan ic_more
      attr/:     colorSurface colorPrimary colorOnSurface colorOnSurfaceVariant
                 colorError colorOnError actionBarSize selectableItemBackgroundBorderless
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/accountManagerTitle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <GridLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp"
            android:columnCount="4"
            android:rowCount="2"
            android:useDefaultMargins="false"
            android:alignmentMode="alignMargins">

            <LinearLayout
                android:id="@+id/cellScanLogin"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_qr_scan"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@string/scanLogin" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/scanLogin"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:enabled="false">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_more"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/comingSoon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/comingSoon"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:enabled="false">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_more"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/comingSoon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/comingSoon"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:enabled="false">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_more"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/comingSoon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/comingSoon"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:enabled="false">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_more"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/comingSoon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/comingSoon"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:enabled="false">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_more"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/comingSoon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/comingSoon"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:enabled="false">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_more"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/comingSoon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/comingSoon"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:enabled="false">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_more"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:contentDescription="@string/comingSoon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/comingSoon"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

        </GridLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/logout"
        android:textColor="?attr/colorOnError"
        app:backgroundTint="?attr/colorError"
        app:cornerRadius="26dp" />

</LinearLayout>
